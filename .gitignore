## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ins.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
~$*

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/
# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/

# Visual Studio 2017 auto generated files
Generated\ Files/

# Visual Studio 2017+ Test Explorer cache
.TestStore/

# MAC
.DS_Store

# Test artifacts, logs and screenshots
*.log
crash_log.txt
page_test_report.txt
test_report.txt
shots/
*.tmp
*.temp

# Local tools & scripts
tools/*
!tools/start_mysql.ps1

# Local secrets and machine-specific configuration
.env
.env.*
!.env.example
*.secrets.json
appsettings.Development.json

# IDE and editors
.idea/
.vscode/

# Local QA work, generated reports, and submission archives
/work/
/Bao_cao_BTL_ComputerStore*.docx
/Bao_cao_BTL_ComputerStore*.pdf
/ComputerStore_BTL_MaNguon*.zip
/ComputerStore_SourceCode*.zip
